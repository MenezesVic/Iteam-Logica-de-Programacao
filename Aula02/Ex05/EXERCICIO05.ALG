Algoritmo "Exercicio05"
// Autor(a)    : Victor Menezes
// Data atual  : 03/08/2026
Var
// Seção de Declarações das variáveis
   numero : inteiro


Inicio
      escreva("Informe um número: ")
      leia(numero)
      
      se(numero % 2 = 0) entao
           escreval("O número ", numero, " é Par")
      senao
           escreval("O número ", numero, " não é Par")
      fimse

Fimalgoritmo