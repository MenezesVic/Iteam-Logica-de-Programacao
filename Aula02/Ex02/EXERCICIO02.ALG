Algoritmo "Exercicio02"
// Autor(a)    : Victor Menezes
// Data atual  : 03/08/2026

Var
// Seção de Declarações das variáveis 
   nome: caractere
Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
   escreval("Digite o seu nome:  ")
   leia(nome)
   escreval("Olá, ", nome)


Fimalgoritmo