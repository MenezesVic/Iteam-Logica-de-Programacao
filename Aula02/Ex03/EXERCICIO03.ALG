Algoritmo "Exercicio03"
// Autor(a)    : Victor Menezes
// Data atual  : 03/08/2026
Var
// Seção de Declarações das variáveis 
   num1 : inteiro
   dobro : inteiro


Inicio
// Seção de Comandos, procedimento, funções, operadores, etc...
   escreva("Informe o número: ")
   leia(num1)
   dobro <- num1 * 2
   escreval(num1, " * 2 = ", dobro)
   


Fimalgoritmo