Algoritmo "Exercicio04"
// Autor(a)    : Victor Menezes
// Data atual  : 03/08/2026
Var
// Seção de Declarações das variáveis
   idade : inteiro


Inicio

      escreva("Informe a sua idade: ")
      leia(idade)
      
      se (idade >= 18)entao
         escreval("Pode Dirigir!")
      senao
           escreval("Não pode dirigir")
      fimse

Fimalgoritmo